# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Variables starting with NEXT_PUBLIC_ are sent to the browser. Everything else stays on the server.

# --- Supabase (Phase 1) ---
# Project URL and anon key: safe for the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: bypasses row-level security. SERVER ONLY (cron jobs, admin actions).
SUPABASE_SERVICE_ROLE_KEY=

# --- Listings aggregator (Phase 5) ---
# JSearch on RapidAPI (rapidapi.com, subscribe to JSearch). Server only. Leave empty to skip imports;
# the daily job then only hides expired listings. The job makes 2 requests a day (about 60 a month):
# check your plan's monthly quota first.
JSEARCH_API_KEY=

# --- Geocoding (Phase 1) ---
# Nominatim requires an identifying User-Agent with a contact address for the app (not a personal email).
NOMINATIM_USER_AGENT=InternQuest/0.1 (contact: replace-with-project-contact)

# --- Optional AI helper (Phase 4) ---
# An Anthropic API key (console.anthropic.com). Server only. Leave empty to turn the AI helper off.
# Each user gets 5 drafts a day. Watch the spend in the Anthropic console and set a monthly limit there.
AI_API_KEY=
# Optional. Defaults to claude-opus-5-5. A cheaper model (for example claude-haiku-5-5) costs less per draft.
AI_MODEL=

# --- Optional email (Phase 6) ---
# Resend (resend.com) sends a registering company its "confirm your email" link. Server only.
# Leave empty to skip it: the admin then confirms the company's email by hand during review.
RESEND_API_KEY=
# The sender, on a domain verified in Resend, for example: InternQuest <no-reply@your-domain.ph>
RESEND_FROM=
# The site's public address, used to build links in emails. Defaults to http://localhost:3000.
SITE_URL=

# --- Scheduled jobs ---
# Shared secret that Vercel Cron sends ("Authorization: Bearer <secret>"), so nobody else can
# trigger the jobs. At least 16 random characters. Set the same value in Vercel's project settings.
CRON_SECRET=
